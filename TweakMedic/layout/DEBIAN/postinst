#!/bin/sh
set +e
ROOT=/var/mobile/Library/TweakMedic
mkdir -p "$ROOT/Staging" "$ROOT/Disabled" "$ROOT/Reports"
chown -R mobile:mobile "$ROOT" 2>/dev/null || true
chmod 0755 "$ROOT" "$ROOT/Staging" "$ROOT/Disabled" "$ROOT/Reports" 2>/dev/null || true
launchctl bootout system/com.nightvibes33.tweakmedicd 2>/dev/null || true
launchctl bootout system /var/jb/Library/LaunchDaemons/com.nightvibes33.tweakmedicd.plist 2>/dev/null || true
launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.nightvibes33.tweakmedicd.plist 2>/dev/null || launchctl load /var/jb/Library/LaunchDaemons/com.nightvibes33.tweakmedicd.plist 2>/dev/null || true
if [ -x /var/jb/usr/bin/uicache ]; then /var/jb/usr/bin/uicache -p /var/jb/Applications/TweakMedic.app 2>/dev/null || /var/jb/usr/bin/uicache -a 2>/dev/null || true; fi
killall -9 Preferences 2>/dev/null || true
exit 0
