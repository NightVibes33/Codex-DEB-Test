#!/bin/sh
set -e
case "$1" in
 configure|abort-upgrade|abort-deconfigure)
  export PATH=/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/usr/bin:/usr/sbin:/bin:$PATH
  PLIST=/var/jb/Library/LaunchDaemons/com.nightvibes.smr.rootd.plist
  APP=/var/jb/Applications/SafeModeRepair.app
  if [ -f "$PLIST" ]; then
   launchctl bootout system "$PLIST" >/dev/null 2>&1 || true
   launchctl bootstrap system "$PLIST" >/dev/null 2>&1 || launchctl load -w "$PLIST" >/dev/null 2>&1 || true
   launchctl kickstart -k system/com.nightvibes.smr.rootd >/dev/null 2>&1 || true
  fi
  if command -v uicache >/dev/null 2>&1; then
   uicache -p "$APP" >/dev/null 2>&1 || uicache -a >/dev/null 2>&1 || true
  fi
  echo "Safe Mode Repair installed. Home Screen app: com.nightvibes.safemoderepair"
  ;;
esac
exit 0
